# --- Required ---
# MongoDB Atlas connection string (database name "anjelab")
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/anjelab
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=12h
PORT=4000

# --- Production ---
NODE_ENV=production
# Site origins allowed to call the API (comma-separated). Empty = allow all (dev only).
CORS_ORIGIN=https://anjelab.com,https://www.anjelab.com
# Public URL of this API (used for local-disk file links)
PUBLIC_API_URL=https://anjelab-api.onrender.com

# --- Image & PDF storage (Cloudinary). Without them, files go to ./uploads (dev only). ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- On-demand revalidation of the Next.js site after a catalogue change ---
SITE_REVALIDATE_URL=https://anjelab.com/api/revalidate
# Must equal REVALIDATE_SECRET in the site's environment
REVALIDATE_SECRET=
