{
  "name": "anjelab-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ANJELAB API — product catalogue, categories, quote requests, uploads. Deployed on Render.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
