# Copy to .env.development.local for `npm run dev` (Next ignores .env.production in dev).
# Production values live in the committed .env.production.
# URL of the Express API. Read at build time and in the browser (admin, quote form).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of this site (canonicals, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
