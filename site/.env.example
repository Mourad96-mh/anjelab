# URL of the Express API (Render). Used server-side and in the browser (admin, quote form).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of this site (canonicals, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared with the API's REVALIDATE_SECRET: lets the API purge the page cache after a catalogue change
REVALIDATE_SECRET=change-me
